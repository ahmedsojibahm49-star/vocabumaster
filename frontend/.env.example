# VocabMaster frontend settings — copy to `.env` if you need to change the API URL.
# In local dev (`npm run dev`) this can stay as-is: Vite proxies /api to
# the backend on :4000. For a separately hosted frontend (Vercel/Netlify),
# set this to your backend URL, e.g. https://vocabmaster-api.onrender.com/api
VITE_API_URL=http://localhost:4000/api
