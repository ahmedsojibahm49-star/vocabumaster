# VocabMaster backend settings — copy to `.env` and fill in (never commit .env).
# See SETUP-BANGLA.md for where to get these values.

# Turso database URL. Remote: libsql://<database-name>-<org>.turso.io
# Local file (development / testing, no account needed): file:./local.db
# (a relative file: URL always means backend/local.db, wherever you run from)
TURSO_DATABASE_URL=libsql://vocabmaster-jarif-ahmed49.aws-ap-southeast-1.turso.io


